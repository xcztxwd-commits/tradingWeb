FROM node:22-alpine AS build
WORKDIR /workspace
RUN npm install --global pnpm@10.4.1
COPY . .
RUN --mount=type=cache,id=tradingweb-pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm run build
RUN --mount=type=cache,id=tradingweb-npm,target=/root/.npm \
    npm --prefix fx-trading-platform ci --no-audit --no-fund
RUN npm --prefix fx-trading-platform run web:build \
    && npm --prefix fx-trading-platform run admin:build

FROM nginx:1.27-alpine AS web
COPY fx-trading-platform/infra/nginx.local.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/fx-trading-platform/apps/web/dist /usr/share/nginx/html

FROM nginx:1.27-alpine AS admin
COPY fx-trading-platform/infra/nginx.local.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/fx-trading-platform/apps/admin/dist /usr/share/nginx/html
