FROM eclipse-temurin@sha256:8c2dddf1bb2a8455160f4e23080059de5003eddc5cb839130b177c6be0c2cfe0 AS runtime
WORKDIR /app
RUN mkdir -p /app/var/engagement-assets && chown -R 10001:10001 /app
COPY --chown=10001:10001 target/fx-platform-backend-0.1.0.jar /app/app.jar
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
