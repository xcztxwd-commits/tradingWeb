{
  "name": "fx-trading-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contract:export": "node scripts/export-openapi.mjs",
    "contract:generate": "node scripts/generate-openapi-types.mjs",
    "contract:check": "node scripts/generate-openapi-types.mjs --check",
    "contract:ci": "npm run contract:export && npm run contract:check && npm run web:test && npm run web:build && npm run admin:build && npm run smoke:backend",
    "test:frontend-boundaries": "node --test scripts/verify-frontend-boundaries.test.mjs",
    "verify:frontend-boundaries": "node scripts/verify-frontend-boundaries.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "smoke:backend": "node scripts/smoke-backend.mjs",
    "smoke:business-closed-loop": "node scripts/smoke-business-closed-loop.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "smoke:real-trading-loop": "node scripts/smoke-real-trading-loop.mjs",
    "smoke:usdt-demo-browser": "node scripts/smoke-usdt-demo-browser.mjs",
    "smoke:btcusdt-perp-50x": "node scripts/smoke-usdt-demo-browser.mjs",
    "acceptance:p0-user-trading": "node scripts/smoke-usdt-demo-browser.mjs --suite=p0",
    "smoke:ethusdt-perp-20x": "node scripts/smoke-ethusdt-perp-20x-position-chain.mjs",
    "smoke:user-core-pages": "node scripts/smoke-user-core-pages.mjs",
    "smoke:trading-login-gate": "node scripts/smoke-trading-login-gate.mjs",
    "smoke:visual-qa": "node scripts/smoke-visual-qa.mjs",
    "web:smoke:trading": "node scripts/smoke-trading-login-gate.mjs",
    "web:dev": "npm --workspace apps/web run dev",
    "web:test": "npm --workspace apps/web run test",
    "web:build": "npm --workspace apps/web run build",
    "web:bundle-budget": "npm run web:build && node scripts/check-web-bundle-budget.mjs",
    "audit:large-files": "node scripts/audit-large-files.mjs",
    "ui:test": "npm --workspace packages/ui run test",
    "ui:typecheck": "npm --workspace packages/ui run typecheck",
    "ui:smoke": "node scripts/smoke-ui-primitives.mjs",
    "frontend-core:test": "npm --workspace packages/frontend-core run test",
    "frontend-core:typecheck": "npm --workspace packages/frontend-core run typecheck",
    "frontend:check": "npm run ui:test && npm run ui:typecheck && npm run frontend-core:test && npm run frontend-core:typecheck && npm run web:test && npm run web:build && npm run verify:frontend-boundaries && npm run verify:architecture && npm run web:bundle-budget && npm run audit:large-files",
    "admin:dev": "npm --workspace apps/admin run dev",
    "admin:build": "npm --workspace apps/admin run build"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
